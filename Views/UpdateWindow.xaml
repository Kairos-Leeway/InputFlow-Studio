<Window x:Class="InputFlowStudio.UpdateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="软件更新 · InputFlow Studio" Icon="../Assets/App.ico" Width="660" Height="650" MinWidth="580" MinHeight="520" WindowStartupLocation="CenterScreen" Topmost="True" ShowInTaskbar="True" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="13">
  <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
  <DockPanel Margin="26">
    <StackPanel DockPanel.Dock="Top"><TextBlock x:Name="Heading" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="Versions" Style="{StaticResource Label}" Margin="0,10,0,18"/></StackPanel>
    <StackPanel DockPanel.Dock="Bottom">
      <ProgressBar Background="{DynamicResource Field}" Foreground="{DynamicResource Accent}" x:Name="Progress" Height="7" Minimum="0" Maximum="1" Margin="0,16,0,8"/>
      <TextBlock x:Name="StatusText" TextWrapping="Wrap" Margin="0,0,0,16" Foreground="{DynamicResource Muted}"/>
      <WrapPanel HorizontalAlignment="Right"><Button Content="发布页" Click="OpenPage"/><Button x:Name="SkipButton" Content="跳过此版本" Click="Skip"/><Button x:Name="LaterButton" Content="稍后" Click="Later"/><Button x:Name="DownloadButton" Content="下载更新" Click="Download" Style="{StaticResource Primary}" Margin="0"/></WrapPanel>
    </StackPanel>
    <Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><TextBlock VerticalAlignment="Top" x:Name="Notes" TextWrapping="Wrap" LineHeight="23"/></ScrollViewer></Border>
  </DockPanel>
</Window>
