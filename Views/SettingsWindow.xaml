<Window x:Class="InputFlowStudio.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:InputFlowStudio" Title="设置 · InputFlow Studio" Icon="../Assets/App.ico" Width="760" Height="820" MinWidth="680" MinHeight="680" WindowStartupLocation="CenterOwner" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="13"><Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="../Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries>
<Style TargetType="TabControl"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><DockPanel><TabPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="0,0,0,16"/><Border Background="{DynamicResource Panel}" CornerRadius="10" Padding="20"><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></Border></DockPanel></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="B" Padding="18,10" Margin="0,0,6,0" CornerRadius="7" Background="{DynamicResource Field}" BorderThickness="1" BorderBrush="{DynamicResource Line}"><ContentPresenter ContentSource="Header"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
<Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Margin" Value="0,8,0,10"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
</ResourceDictionary></Window.Resources><DockPanel Margin="28"><StackPanel DockPanel.Dock="Top"><TextBlock Text="设置" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="快捷键、录制与个性化" Style="{StaticResource Label}" Margin="0,8,0,18"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><TextBlock x:Name="ErrorText" Foreground="{DynamicResource RecordInk}" TextWrapping="Wrap" Margin="0,10"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="恢复默认" Click="Defaults"/><Button Content="取消" Click="Cancel"/><Button Content="保存并应用" Click="Apply" Style="{StaticResource Primary}" Margin="0"/></StackPanel></StackPanel><TabControl x:Name="SettingsTabs"><TabItem Header="快捷键"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><TextBlock Text="全局快捷键" Style="{StaticResource Section}" Margin="0,0,0,8"/><TextBlock Text="点击输入框后直接按下按键或组合键，支持 Ctrl、Alt、Shift、Win。Tab 切换输入框；设置期间暂停本工具的全局快捷键。" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,14"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><TextBlock Text="录制 / 停止录制"/><TextBox Grid.Column="1" Text="{Binding Record, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PreviewKeyDown="Capture"/><TextBlock Grid.Row="1" Text="运行 / 停止方案"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Run, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PreviewKeyDown="Capture"/><TextBlock Grid.Row="2" Text="紧急停止 / 取消倒计时"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Stop, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PreviewKeyDown="Capture"/><TextBlock Grid.Row="3" Text="暂停 / 恢复"/><TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Pause, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PreviewKeyDown="Capture"/><TextBlock Grid.Row="4" Text="拾取鼠标坐标"/><TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Pick, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PreviewKeyDown="Capture"/><TextBlock Grid.Row="5" Text="添加步骤（空闲时）"/><TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Add, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" PreviewKeyDown="Capture"/></Grid><TextBlock Text="当前方案快捷键" Style="{StaticResource Section}"/><TextBlock x:Name="PlanName" Style="{StaticResource Label}"/><TextBox x:Name="PlanShortcut" IsReadOnly="True" PreviewKeyDown="Capture" Tag="Optional"/><TextBlock Text="Backspace 清空并禁用。空闲时按此键直接运行当前方案。" Style="{StaticResource Label}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="录制与运行"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><TextBlock Text="录制准备" Style="{StaticResource Section}" Margin="0,0,0,12"/><CheckBox Content="录制准备时隐藏主窗口" IsChecked="{Binding HideMainWindow}"/><CheckBox Content="录制结束后自动弹出主界面" IsChecked="{Binding ShowMainAfterRecording}"/><TextBlock Text="关闭后主窗口保持隐藏，可双击系统托盘图标重新打开。取消准备或发生错误时仍会恢复窗口。" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,12"/><TextBlock Text="开始前倒计时（0–10 秒，0 为立即开始）" Style="{StaticResource Label}"/><TextBox Text="{Binding CountdownSeconds, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><CheckBox Content="录制键盘操作" IsChecked="{Binding RecordKeyboard}"/><CheckBox Content="录入本工具快捷键（如停止录制的按键）" IsChecked="{Binding IncludeControlHotkeys}"/><TextBlock Text="仅在键盘录制开启时生效。默认关闭，排除本工具的快捷键；开启后保留其按键，回放时不会触发本工具自身操作。" Style="{StaticResource Label}" TextWrapping="Wrap"/><CheckBox Content="记录鼠标移动轨迹" IsChecked="{Binding RecordMovement}"/><TextBlock Text="关闭后仍保留点击坐标及时间间隔；拖拽路径不会被保存。" Style="{StaticResource Label}" TextWrapping="Wrap"/><TextBlock Text="运行准备与状态" Style="{StaticResource Section}"/><CheckBox Content="运行时隐藏主界面" IsChecked="{Binding HideWhenRunning}"/><TextBlock Text="从运行倒计时开始隐藏；结束、取消、停止或报错后恢复。隐藏期间仍可使用快捷键与系统托盘。" Style="{StaticResource Label}" TextWrapping="Wrap"/><CheckBox Content="运行前显示倒计时" IsChecked="{Binding EnableRunCountdown}"/><TextBlock Text="运行倒计时秒数（1–10 秒）" Style="{StaticResource Label}"/><TextBox IsEnabled="{Binding EnableRunCountdown}" Text="{Binding RunCountdownSeconds, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><CheckBox Content="显示运行状态指示灯（运行 / 暂停 / 停止）" IsChecked="{Binding ShowRunningIndicator}"/><CheckBox Content="显示运行快捷键提示" IsChecked="{Binding ShowRunningHints}"/><CheckBox Content="显示循环进度和已完成轮数" IsChecked="{Binding ShowLoopCounter}"/><TextBlock Text="浮层不会抢焦点，鼠标可穿透。循环完成后才计入已完成次数；无限循环也会累计。" Style="{StaticResource Label}" TextWrapping="Wrap"/><TextBlock Text="录制提示浮层" Style="{StaticResource Section}"/><CheckBox Content="显示录制状态指示灯" IsChecked="{Binding ShowRecordingIndicator}"/><CheckBox Content="显示录制快捷键提示（鼠标可穿透）" IsChecked="{Binding ShowRecordingHints}"/><TextBlock Text="关闭后不再显示快捷键提示；快捷键仍有效，开始前的数字倒计时仍显示。" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBlock Text="录制与运行浮层位置（开始时鼠标所在的显示器）" Style="{StaticResource Label}"/><ComboBox x:Name="Corner" SelectedItem="{Binding OverlayCorner}"/><TextBlock Text="浮层透明度（40%–100%）" Style="{StaticResource Label}"/><Slider x:Name="OverlayOpacitySlider" Minimum="0.4" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding OverlayOpacity, Mode=TwoWay}" Margin="0,14"/><TextBlock Text="{Binding Value, ElementName=OverlayOpacitySlider, StringFormat=当前透明度：{0:P0}}" Style="{StaticResource Label}"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="外观与默认值"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><TextBlock Text="外观" Style="{StaticResource Section}" Margin="0,0,0,12"/><TextBlock Text="应用主题" Style="{StaticResource Label}"/><ComboBox x:Name="ThemeChoice" SelectedItem="{Binding Theme}"/><TextBlock Text="保存后应用，重新启动会保留选择。" Style="{StaticResource Label}"/><TextBlock Text="新方案默认值" Style="{StaticResource Section}"/><TextBlock Text="只对之后新建的方案生效，不覆盖已有方案。倍速、循环次数与循环间隔仍分别保存在各自的方案中。" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,14"/><TextBlock Text="默认倍速（0.1–10 倍）" Style="{StaticResource Label}"/><TextBox Text="{Binding DefaultSpeed, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="默认循环次数（0 为无限）" Style="{StaticResource Label}"/><TextBox Text="{Binding DefaultLoops, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/><TextBlock Text="默认循环间隔（毫秒）" Style="{StaticResource Label}"/><TextBox Text="{Binding DefaultLoopDelay, ValidatesOnExceptions=True, NotifyOnValidationError=True}"/></StackPanel></ScrollViewer></TabItem><TabItem Header="关于与更新"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,10,0"><TextBlock Text="InputFlow Studio" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{x:Static local:UpdateService.CurrentVersionText}" Style="{StaticResource Label}" Margin="0,10,0,20"/><TextBlock Text="软件更新" Style="{StaticResource Section}"/><CheckBox Content="启动时检查更新（每天最多自动检查一次）" IsChecked="{Binding CheckUpdatesOnStartup}"/><TextBlock Text="从 Kairos-Leeway/InputFlow-Studio 的正式 Releases 获取版本信息。录制、运行或其他弹窗期间不打断当前操作。" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,16"/><WrapPanel><Button x:Name="CheckUpdateButton" Content="检查更新" Click="CheckUpdate" Style="{StaticResource Primary}"/><Button Content="打开发布页" Click="OpenRelease"/></WrapPanel><TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Margin="0,16,0,16" Foreground="{DynamicResource Muted}"/><TextBlock Text="有新版本时可查看更新说明、跳过此版本或下载。下载完成后先校验，再由你确认退出并安装；未保存的方案修改仍会提示处理。手动检查会重新显示已跳过的版本。" Style="{StaticResource Label}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></TabItem></TabControl></DockPanel></Window>
