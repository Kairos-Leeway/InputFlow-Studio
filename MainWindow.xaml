<Window x:Class="InputFlowStudio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:InputFlowStudio" Icon="Assets/App.ico" UseLayoutRounding="True" SnapsToDevicePixels="True" Title="InputFlow Studio" Width="1380" Height="900" MinWidth="1120" MinHeight="740" WindowStartupLocation="CenterScreen" Background="{DynamicResource Canvas}" Foreground="{DynamicResource Ink}" FontFamily="Microsoft YaHei UI" FontSize="13">
<Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Themes/Studio.xaml"/></ResourceDictionary.MergedDictionaries><local:ActionLabelConverter x:Key="ActionLabel"/></ResourceDictionary></Window.Resources>
<Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
<Grid><StackPanel Orientation="Horizontal"><Image Source="Assets/App.png" Width="44" Height="44" Margin="0,0,14,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="InputFlow" FontFamily="Segoe UI Variable Display" FontSize="27" FontWeight="SemiBold"/><TextBlock Text="Studio / 键鼠自动化工作台" Style="{StaticResource Label}" Margin="1,3,0,0"/></StackPanel></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="⚙ 设置" Click="Settings" IsEnabled="{Binding CanEdit}"/><Button IsEnabled="{Binding CanEdit}" Content="导入方案" Click="Import"/><Button Content="导出" Click="Export"/><TextBlock Text="{Binding SaveState}" Margin="8,0,12,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Style.Triggers><DataTrigger Binding="{Binding HasUnsaved}" Value="True"><Setter Property="Foreground" Value="{DynamicResource DirtyInk}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="保存" Click="Save" IsEnabled="{Binding CanEdit}"/></StackPanel></Grid>
<Border Grid.Row="1" Background="{DynamicResource Panel}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="14,12" Margin="0,0,0,16"><WrapPanel VerticalAlignment="Center">
<Button x:Name="RecordButton" Content="{Binding RecordText}" IsEnabled="{Binding CanRecord}" Click="Record" Foreground="{DynamicResource RecordInk}" Margin="0,3,8,3" MinHeight="42"/>
<Button x:Name="RunButton" Content="{Binding RunText}" IsEnabled="{Binding CanRun}" Click="Run" Style="{StaticResource Primary}" Margin="0,3,8,3" MinHeight="42"/>
<Button x:Name="PauseButton" Content="{Binding PauseText}" IsEnabled="{Binding CanPause}" Click="Pause" Margin="0,3,8,3" MinHeight="42"/>
<Border local:EditIndicator.Changed="{Binding Selected.SpeedChanged}" BorderBrush="{DynamicResource Line}" BorderThickness="1,0,0,0" Padding="16,0,4,0" Margin="8,3,4,3" IsEnabled="{Binding CanChangeSpeed}"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="{Binding PlaybackSpeed, StringFormat=倍速  {0:0.0}×}" MinWidth="86"/><Slider local:EditIndicator.Changed="{Binding Selected.SpeedChanged}" x:Name="SpeedSlider" Width="160" Minimum="0.1" Maximum="10" TickFrequency="0.1" IsSnapToTickEnabled="True" Value="{Binding PlaybackSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" ToolTip="0.1–10 倍，运行和暂停时均可实时调整"/><Button Content="↶" Click="RestoreField" Tag="Plan.Speed" IsEnabled="{Binding Selected.SpeedChanged}" ToolTip="还原已保存倍速" Padding="6,4" Margin="8,0,0,0"/></StackPanel></Border>
<TextBlock Text="{Binding ToolbarHint}" Style="{StaticResource Label}" Margin="14,12"/>
</WrapPanel></Border>
<Border x:Name="Notice" Grid.Row="2" Visibility="Collapsed" Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,0,12"><DockPanel><Button DockPanel.Dock="Right" Content="×" Click="DismissNotice" Padding="8,3" Margin="12,0,0,0"/><TextBlock x:Name="NoticeText" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
<Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="310"/></Grid.ColumnDefinitions>
<Border Background="{DynamicResource Panel}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="16"><DockPanel IsEnabled="{Binding CanEdit}"><StackPanel DockPanel.Dock="Top"><TextBlock Text="方案库" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="组织你的自动化流程" Style="{StaticResource Label}" Margin="0,6,0,18"/><Button Content="＋  新建方案" Click="New" Margin="0,0,0,12"/></StackPanel><StackPanel DockPanel.Dock="Bottom"><Separator Margin="0,10"/><UniformGrid Columns="2"><Button Content="复制" Click="Copy"/><Button Content="删除" Click="DeletePlan" Margin="0"/></UniformGrid></StackPanel><ListBox ItemsSource="{Binding Plans}" SelectedItem="{Binding Selected}"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="● 未保存修改" Foreground="{DynamicResource DirtyInk}" FontSize="11"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDirty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding Steps.Count, StringFormat=共 {0} 个操作步骤}" Style="{StaticResource Label}" Margin="0,6,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border>
<Border Grid.Column="2" Background="{DynamicResource Panel}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="20"><DockPanel><StackPanel DockPanel.Dock="Top"><TextBlock Text="操作序列" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding StepSummary}" Style="{StaticResource Label}" Margin="0,7,0,12"/><ComboBox ItemsSource="{Binding FilterOptions}" SelectedIndex="{Binding FilterIndex}"/><TextBlock Text="搜索类型、坐标或 #原始编号" Style="{StaticResource Label}"/><TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" ToolTip="搜索点击、等待、坐标或 #步骤编号"/><WrapPanel Margin="0,0,0,12"><Button Content="上一个关键操作" Click="PreviousImportant"/><Button Content="下一个关键操作" Click="NextImportant"/></WrapPanel><Border Height="1" Background="{DynamicResource Line}" Margin="0,0,0,12"/></StackPanel><WrapPanel DockPanel.Dock="Bottom" Margin="0,14,0,0" IsEnabled="{Binding CanEdit}"><Button Content="{Binding AddText}" Click="Add" Style="{StaticResource Primary}" Margin="0,3,7,3"/><Button Content="删除" Click="DeleteStep" Margin="0,3,7,3"/><Button Content="↑" Click="Up" Margin="0,3,7,3"/><Button Content="↓" Click="Down" Margin="0,3,0,3"/></WrapPanel><Grid><TextBlock Text="{Binding EmptyHint}" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding StepsView.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><ListBox x:Name="Steps" ItemsSource="{Binding StepsView}" SelectedItem="{Binding SelectedStep, Mode=TwoWay}" AlternationCount="2147483647"><ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{DynamicResource Panel}" Width="40" Height="32" CornerRadius="6" VerticalAlignment="Center"><TextBlock Text="{Binding Number, StringFormat='#{0}'}" Foreground="{DynamicResource Accent}" FontSize="12" HorizontalAlignment="Center"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Kind, Converter={StaticResource ActionLabel}}" FontWeight="SemiBold"/><TextBlock Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Label}"><Style.Triggers><DataTrigger Binding="{Binding IsKeyboard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></TextBlock.Style><Run Text="X "/><Run Text="{Binding X}"/><Run Text="   Y "/><Run Text="{Binding Y}"/></TextBlock><TextBlock Text="{Binding KeyDisplay}" Margin="0,5,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Label}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding Duration, StringFormat={}{0} ms}" HorizontalAlignment="Right"/><TextBlock Text="{Binding Interval, StringFormat=间隔 {0} ms}" Style="{StaticResource Label}" Margin="0,5,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></DockPanel></Border>
<Border Grid.Column="4" Background="{DynamicResource Panel}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="20,12"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,0,8,0" IsEnabled="{Binding CanEdit}"><TextBlock Text="参数面板" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,8"/><TextBlock Text="橙色边框 = 待保存修改 · ↶ 单项还原" Foreground="{DynamicResource DirtyInk}" FontSize="11" Margin="0,0,0,10"/><WrapPanel Margin="0,0,0,10"><Button Content="撤回修改" Click="UndoEdit" IsEnabled="{Binding CanUndo}" Padding="9,7" Margin="0,3,6,3"/><Button Content="还原当前步骤" IsEnabled="{Binding CanRestoreStep}" Click="RestoreStep" Padding="9,7" Margin="0,3,6,3"/><Button Content="还原整个方案" IsEnabled="{Binding CanRestorePlan}" Click="RestorePlan" Padding="9,7" Margin="0,3,0,3"/></WrapPanel><TextBlock Text="方案名称" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding Selected.Name, Mode=OneWay}" local:EditIndicator.Changed="{Binding Selected.NameChanged}" IsReadOnly="True"/><Button Grid.Column="1" Content="↶" Click="RestoreField" Tag="Plan.Name" IsEnabled="{Binding Selected.NameChanged}" ToolTip="还原最近保存的值" Padding="7,4" Margin="5,6,0,12"/></Grid><Button Content="重命名方案" Click="Rename" Margin="0,0,0,10"/><StackPanel IsEnabled="{Binding DataContext.CanEditStep, RelativeSource={RelativeSource AncestorType=Window}}" DataContext="{Binding SelectedItem, ElementName=Steps}"><TextBlock Text="步骤设置" Style="{StaticResource Section}"/><TextBlock Text="操作类型" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="Kinds" local:EditIndicator.Changed="{Binding KindChanged}" SelectedItem="{Binding Kind}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Converter={StaticResource ActionLabel}}" Foreground="{DynamicResource Ink}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="1" Content="↶" Click="RestoreField" Tag="Step.Kind" IsEnabled="{Binding KindChanged}" ToolTip="还原最近保存的值" Padding="7,4" Margin="5,6,0,12"/></Grid><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsKeyboard}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="按键 / 组合键" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="KeyboardEditor" Text="{Binding KeyDisplay, Mode=OneWay}" IsReadOnly="True" local:EditIndicator.Changed="{Binding KeyChanged}" PreviewKeyDown="CaptureKeyboardStep" PreviewKeyUp="CaptureKeyboardRelease" GotKeyboardFocus="BeginKeyCapture" LostKeyboardFocus="EndKeyCapture" ToolTip="点击后按键或组合键，点击其他位置结束"/><Button Grid.Column="1" Content="↶" Click="RestoreField" Tag="Step.Keyboard" IsEnabled="{Binding KeyChanged}" Padding="7,4" Margin="5,6,0,12"/></Grid><TextBlock Text="按下 / 释放可分开编辑；按键操作会按耗时自动释放。" Style="{StaticResource Label}" TextWrapping="Wrap" Margin="0,0,0,12"/></StackPanel><Grid><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsKeyboard}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="X 坐标" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="XEditor" Text="{Binding X, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" local:EditIndicator.Changed="{Binding XChanged}"/><Button Grid.Column="1" Content="↶" Click="RestoreField" Tag="Step.X" IsEnabled="{Binding XChanged}" ToolTip="还原最近保存的值" Padding="7,4" Margin="5,6,0,12"/></Grid></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Y 坐标" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="YEditor" Text="{Binding Y, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" local:EditIndicator.Changed="{Binding YChanged}"/><Button Grid.Column="1" Content="↶" Click="RestoreField" Tag="Step.Y" IsEnabled="{Binding YChanged}" ToolTip="还原最近保存的值" Padding="7,4" Margin="5,6,0,12"/></Grid></StackPanel></Grid><TextBlock Text="动作耗时 / 按键保持（ms）" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox IsEnabled="{Binding UsesDuration}" x:Name="DurationEditor" Text="{Binding Duration, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" local:EditIndicator.Changed="{Binding DurationChanged}"/><Button Grid.Column="1" Content="↶" Click="RestoreField" Tag="Step.Duration" IsEnabled="{Binding DurationChanged}" ToolTip="还原最近保存的值" Padding="7,4" Margin="5,6,0,12"/></Grid><TextBlock Text="操作前间隔（ms）" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="IntervalEditor" Text="{Binding Interval, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" local:EditIndicator.Changed="{Binding IntervalChanged}"/><Button Grid.Column="1" Content="↶" Click="RestoreField" Tag="Step.Interval" IsEnabled="{Binding IntervalChanged}" ToolTip="还原最近保存的值" Padding="7,4" Margin="5,6,0,12"/></Grid><StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Kind}" Value="{x:Static local:ActionKind.Wheel}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="滚轮增量（120 为一格）" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WheelEditor" Text="{Binding Wheel, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" local:EditIndicator.Changed="{Binding WheelChanged}"/><Button Grid.Column="1" Content="↶" Click="RestoreField" Tag="Step.Wheel" IsEnabled="{Binding WheelChanged}" ToolTip="还原最近保存的值" Padding="7,4" Margin="5,6,0,12"/></Grid></StackPanel></StackPanel><Expander Header="循环设置" IsExpanded="True" Foreground="{DynamicResource Ink}" Margin="0,14,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="循环次数（0 为无限）" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LoopsEditor" Text="{Binding Selected.Loops, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" local:EditIndicator.Changed="{Binding Selected.LoopsChanged}"/><Button Grid.Column="1" Content="↶" Click="RestoreField" Tag="Plan.Loops" IsEnabled="{Binding Selected.LoopsChanged}" ToolTip="还原最近保存的值" Padding="7,4" Margin="5,6,0,12"/></Grid><TextBlock Text="循环间隔（ms）" Style="{StaticResource Label}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LoopDelayEditor" Text="{Binding Selected.LoopDelay, ValidatesOnExceptions=True, UpdateSourceTrigger=PropertyChanged}" local:EditIndicator.Changed="{Binding Selected.LoopDelayChanged}"/><Button Grid.Column="1" Content="↶" Click="RestoreField" Tag="Plan.LoopDelay" IsEnabled="{Binding Selected.LoopDelayChanged}" ToolTip="还原最近保存的值" Padding="7,4" Margin="5,6,0,12"/></Grid></StackPanel></Expander></StackPanel></ScrollViewer></Border></Grid>
<Grid Grid.Row="4" Margin="4,8,4,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{DynamicResource Accent}" Margin="0,0,9,0" VerticalAlignment="Center"/><TextBlock Grid.Column="1" x:Name="Status" Text="就绪" Style="{StaticResource Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding StopHint}" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="16,0,0,0"/></Grid>
</Grid></Window>